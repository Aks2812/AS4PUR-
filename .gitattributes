# Line endings: LF in the repository AND in every working tree (Windows
# included). Git for Windows defaults to core.autocrlf=true, which would
# otherwise check text files out as CRLF; a CRLF shell script, systemd unit,
# nginx conf or EnvironmentFile (.env) breaks on Linux ("$'\r': command not
# found", values ending in a carriage return).
* text=auto eol=lf

# Explicit, so these never depend on git's content heuristic
*.sh        text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
*.ini       text eol=lf
*.mako      text eol=lf
*.py        text eol=lf
*.txt       text eol=lf
*.md        text eol=lf
*.html      text eol=lf
*.js        text eol=lf
*.css       text eol=lf
*.svg       text eol=lf
.env.example text eol=lf
.gitattributes text eol=lf
.gitignore  text eol=lf

# Binary: never converted, never diffed as text
*.xlsx      binary
*.xls       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.pdf       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.eot       binary
