# Copy this file to .env and adjust for your environment.
# AS4PUR reads settings with the AS4PUR_ prefix (see app/config.py).
# Nothing tenant-specific or credential-specific belongs here - see
# CLAUDE.md Section 3. This file only ever holds *application* config.

# Where the SQLite database file lives.
AS4PUR_DATABASE_PATH=./data/as4pur.db

# Idle session timeout, in minutes. Sessions extend on each authenticated
# request and expire this many minutes after the last one.
AS4PUR_SESSION_LIFETIME_MINUTES=30

# Must be true in any real deployment - Nginx terminates TLS in front of
# this app (see deploy/README_DEPLOY.md), and the session cookie must
# never be sent over a plaintext channel. Set to false ONLY for local
# development over plain http://127.0.0.1.
AS4PUR_SECURE_COOKIES=true

# Login brute-force protection (CLAUDE.md Section 5).
AS4PUR_LOGIN_RATE_LIMIT_ATTEMPTS=5
AS4PUR_LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Upload limits, enforced before a file is ever handed to an operation's
# parser (CLAUDE.md Section 5).
AS4PUR_UPLOAD_MAX_BYTES=10485760
# Separate, larger ceiling for nsdebug.log uploads only (Device Posture
# Validation) - real logs already run ~9MB, Debug-level ones larger. Keep
# nginx's client_max_body_size (deploy/nginx_as4pur.conf) a little above it.
AS4PUR_NSDEBUG_UPLOAD_MAX_BYTES=52428800
AS4PUR_UPLOAD_TEMP_DIR=./data/uploads_tmp

# Data Export: rows per getusers/getgroups request (1-200). 200 is the only
# size proven against a real tenant; lower it only to test paging.
AS4PUR_DATA_EXPORT_PAGE_SIZE=200

# Email domains an admin may invite from /admin (comma-separated, case-insensitive).
# Empty or missing = every invite is refused until this is set. Replace the placeholder.
AS4PUR_INVITE_ALLOWED_DOMAINS=example.com

# FastAPI's interactive API docs (/docs, /redoc, /openapi.json) list every route and need no
# login. Keep them off (0) on any server; set to 1 only on a development machine.
AS4PUR_ENABLE_API_DOCS=0

# NOT an AS4PUR_ setting, but never put WEB_CONCURRENCY in this file or the service
# environment: AS4PUR must run as ONE process and its workers refuse to start if it is set above 1.
